# Copy to .env and adjust. .env is gitignored, this file is committed.

ENVIRONMENT=development

# Hostnames "db" and "cache" are the docker-compose service names.
DATABASE_URL=postgresql+psycopg://ceylontour:ceylontour@db:5432/ceylontour
REDIS_URL=redis://cache:6379/0

# Returned in the meta block of every response so an explanation shown to a
# user can be reproduced later.
MODEL_VERSION=pressure-v1.2
INDEX_VERSION=weights-v1

# JSON list. The Next.js dev server runs on port 3000.
CORS_ORIGINS=["http://localhost:3000"]

# Replace before anything is deployed.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Read by the postgres image on first start.
POSTGRES_USER=ceylontour
POSTGRES_PASSWORD=ceylontour
POSTGRES_DB=ceylontour

# Host ports only. Containers always talk to each other on 5432/6379/8000.
# Change these if another project on your machine already holds them.
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
